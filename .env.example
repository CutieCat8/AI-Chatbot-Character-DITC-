# ============================================================
# DITC CAT — ตัวอย่างไฟล์ Environment Variables
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  (คำสั่ง: cp .env.example .env)
# ห้าม commit ไฟล์ .env ตัวจริงขึ้น git เด็ดขาด (มี secret)
# ============================================================

# ---------- Database (Postgres + pgvector) ----------
POSTGRES_USER=ditc
POSTGRES_PASSWORD=ditc_dev_password
POSTGRES_DB=ditc_cat
POSTGRES_HOST=db          # ชื่อ service ใน docker-compose (ถ้ารัน local นอก docker ใช้ localhost)
POSTGRES_PORT=5432
# DATABASE_URL ประกอบจากค่าข้างบนอัตโนมัติใน config.py ไม่ต้องกรอกซ้ำ

# ---------- Backend / App ----------
APP_ENV=development        # development | production
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ---------- Security / Auth (JWT — ใช้ตอน Sprint 4 T27) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- LLM / AI Provider (ยังไม่ล็อก — เลือกตอน Sprint 2) ----------
# LLM_PROVIDER รองรับ: claude | deepseek | fake   (สลับได้จากตรงนี้ที่เดียว)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=

# ---------- Embedding (สำหรับ RAG vector search) ----------
# EMBEDDING_PROVIDER: e5 (multilingual-e5-large รันเอง ฟรี, ค่าตั้งต้น) | openai (ต้องมี OPENAI_API_KEY) | fake (จำลอง)
# หมายเหตุ: ถ้าเปลี่ยน provider/model มิติ (EMBEDDING_DIM) อาจเปลี่ยน ต้องสร้าง migration ใหม่
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# ---------- Voice (ต่อจริงตอน Sprint 2) ----------
# STT / TTS: google | azure
STT_PROVIDER=google
TTS_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-sa.json
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------- Voice pipeline (dev-machine, Gemini Live — app/scripts/voice_pipeline_dev.py) ----------
VAD_SPEECH_THRESHOLD=0.5
VAD_SILENCE_TIMEOUT_S=8.0
AUDIO_OUTPUT_BUFFER_S=1.5
VOICE_RECONNECT_MAX_BACKOFF_S=30.0
# ใส่ index ตัวเลข (เช่น 2) หรือส่วนหนึ่งของชื่ออุปกรณ์ (เช่น "Noise-cancelling") เว้นว่าง = default เครื่อง
VOICE_MIC_DEVICE=
VOICE_SPEAKER_DEVICE=

# ---------- Scraper (T03) ----------
# CAMT: server-rendered → ดึงด้วย HTML scraper (ใช้ www. เพราะ apex domain ใบ SSL ไม่ตรงชื่อ)
SCRAPE_HTML_SEEDS=https://www.camt.cmu.ac.th
SCRAPE_INTERVAL_HOURS=24
# DITC: เป็น Next.js SPA → ดึงตรงจาก Strapi CMS (internal API สังเกตจาก network request)
DITC_STRAPI_BASE=https://thankful-nurture-c4e39b7226.strapiapp.com
DITC_SITE_BASE=https://ditc.camt.cmu.ac.th

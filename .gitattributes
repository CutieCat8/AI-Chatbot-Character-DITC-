# Normalize line endings across the team (Windows/Mac/Linux) -> LF in repo
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.riv binary
*.woff binary
*.woff2 binary
